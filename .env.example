# Copy to .env (never commit .env). All values below are placeholders.
DATABASE_URL=postgres://agent_foundry:CHANGE_ME@localhost:5432/agent_foundry
PORT=3000
HOST=127.0.0.1
OWNER_USERNAME=owner
# Plaintext only at bootstrap; stored as scrypt hash. Min 12 chars.
OWNER_PASSWORD=CHANGE_ME_min_12_chars
SESSION_TTL_SECONDS=43200
# Tests use a separate database; it is wiped by the test run.
TEST_DATABASE_URL=postgres://agent_foundry:CHANGE_ME@localhost:5432/agent_foundry_test
